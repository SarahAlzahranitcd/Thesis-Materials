    <!-- http://w3id.org/mmv/0.2#status -->


    <owl:AnnotationProperty rdf:about="http://w3id.org/mmv/0.2#status">
        <rdfs:comment>Indicates the maturity or release status of this MMV version (e.g., Draft, Stable).</rdfs:comment>
        <rdfs:label>status</rdfs:label>
