    <!-- http://www.w3.org/2001/XMLSchema#anySimpleType -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#anySimpleType"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/mmv/0.2#hasAnalysis -->


    <owl:ObjectProperty rdf:about="http://w3id.org/mmv/0.2#hasAnalysis">
        <owl:inverseOf rdf:resource="http://w3id.org/mmv/0.2#isAnalysisOf"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#MappingProject"/>
        <rdfs:range rdf:resource="http://w3id.org/mmv/0.2#AnalysisActivity"/>
        <rdfs:comment>Links a mapping project to its analysis phase, capturing early-stage information such as requirements, assumptions, risks, stakeholders, and input datasets.</rdfs:comment>
        <rdfs:label>hasAnalysis</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasDesign -->


    <owl:ObjectProperty rdf:about="http://w3id.org/mmv/0.2#hasDesign">
        <owl:inverseOf rdf:resource="http://w3id.org/mmv/0.2#isDesignOf"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#MappingProject"/>
        <rdfs:range rdf:resource="http://w3id.org/mmv/0.2#DesignActivity"/>
        <rdfs:comment>Links a mapping project to its design phase, capturing mapping design decisions and their justifications.</rdfs:comment>
        <rdfs:label>hasDesign</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasDevelopment -->


    <owl:ObjectProperty rdf:about="http://w3id.org/mmv/0.2#hasDevelopment">
        <owl:inverseOf rdf:resource="http://w3id.org/mmv/0.2#isDevelopmentOf"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#MappingProject"/>
        <rdfs:range rdf:resource="http://w3id.org/mmv/0.2#DevelopmentActivity"/>
        <rdfs:comment>Links a mapping project to its development phase, capturing details about the implementation of the mapping, including tools, methods, and formats.</rdfs:comment>
        <rdfs:label>hasDevelopment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasInput -->


    <owl:ObjectProperty rdf:about="http://w3id.org/mmv/0.2#hasInput">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#AnalysisActivity"/>
        <rdfs:range rdf:resource="http://w3id.org/mmv/0.2#DataSet"/>
        <rdfs:comment>Links a mapping lifecycle activity to an input dataset or artefact that is analysed, referenced, or used to inform mapping decisions, requirements, or validation criteria.</rdfs:comment>
        <rdfs:label>hasInput</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasMaintenance -->


    <owl:ObjectProperty rdf:about="http://w3id.org/mmv/0.2#hasMaintenance">
        <owl:inverseOf rdf:resource="http://w3id.org/mmv/0.2#isMaintenanceOf"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#MappingProject"/>
        <rdfs:range rdf:resource="http://w3id.org/mmv/0.2#MaintenanceActivity"/>
        <rdfs:comment>Links a mapping project to its maintenance phase, capturing publication, versioning, and long-term management of mapping artifacts.</rdfs:comment>
        <rdfs:label>hasMaintenance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasMappingArtifact -->


    <owl:ObjectProperty rdf:about="http://w3id.org/mmv/0.2#hasMappingArtifact">
        <owl:inverseOf rdf:resource="http://w3id.org/mmv/0.2#isMappingArtifactOf"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#MappingProject"/>
        <rdfs:range rdf:resource="http://w3id.org/mmv/0.2#MappingArtifact"/>
        <rdfs:comment>Links a mapping project snapshot to the mapping artefact(s) documented in that version</rdfs:comment>
        <rdfs:label>hasMappingArtifact</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasPlannedQualityMetric -->


    <owl:ObjectProperty rdf:about="http://w3id.org/mmv/0.2#hasPlannedQualityMetric">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#DesignActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/dqv#Metric"/>
        <rdfs:comment>Links a design activity to the quality metrics that are intended to be applied later when validating the resulting mapping artefact, enabling explicit test planning and reuse-oriented evaluation criteria.</rdfs:comment>
        <rdfs:label>hasPlannedQualityMetric</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasQualityMeasurement -->


    <owl:ObjectProperty rdf:about="http://w3id.org/mmv/0.2#hasQualityMeasurement">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#TestingActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/dqv#QualityMeasurement"/>
        <rdfs:comment>Links a testing activity to computed quality measurements obtained during validation, capturing evidence that supports assessment and informed reuse of the mapping artefact.</rdfs:comment>
        <rdfs:label>hasQualityMeasurement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasStakeholder -->


    <owl:ObjectProperty rdf:about="http://w3id.org/mmv/0.2#hasStakeholder">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#MappingProject"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:comment>Links a mapping project to its stakeholders. Stakeholder agents (foaf:Person or foaf:Agent instances) are expected to be described using FOAF properties such as foaf:name, foaf:homepage, and foaf:organization, alongside MMV-specific stakeholder properties hasRole and hasBackground.</rdfs:comment>
        <rdfs:label>hasStakeholder</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasTesting -->


    <owl:ObjectProperty rdf:about="http://w3id.org/mmv/0.2#hasTesting">
        <owl:inverseOf rdf:resource="http://w3id.org/mmv/0.2#isTestingOf"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#MappingProject"/>
        <rdfs:range rdf:resource="http://w3id.org/mmv/0.2#TestingActivity"/>
        <rdfs:comment>Links a mapping project to its testing phase, capturing validation activities and their outcomes.</rdfs:comment>
        <rdfs:label>hasTesting</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasValidationReport -->


    <owl:ObjectProperty rdf:about="http://w3id.org/mmv/0.2#hasValidationReport">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#TestingActivity"/>
        <rdfs:range rdf:resource="http://w3id.org/mmv/0.2#ValidationReport"/>
        <vann:usageNote xml:lang="en">@prefix mmv: &lt;http://w3id.org/mmv/0.2#&gt; .
@prefix ex: &lt;http://example.org/&gt; .

ex:Testing1 a mmv:TestingActivity ;
    mmv:hasTestingType &quot;SHACL validation&quot; ;
    mmv:hasTestingResult &quot;All constraints passed.&quot; ;
    mmv:hasValidationReport &lt;http://example.org/reports/validation_report.ttl&gt; .</vann:usageNote>
        <rdfs:comment>Links a testing activity to a SHACL validation report (or URL of such a report) that documents constraint-checking outcomes for the mapping artefact, supporting transparent quality evidence.</rdfs:comment>
        <rdfs:label>hasValidationReport</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmv/0.2#isAnalysisOf -->


    <owl:ObjectProperty rdf:about="http://w3id.org/mmv/0.2#isAnalysisOf">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#AnalysisActivity"/>
        <rdfs:range rdf:resource="http://w3id.org/mmv/0.2#MappingProject"/>
        <rdfs:comment>Inverse of hasAnalysis. Relates an AnalysisActivity to the MappingProject it is part of.</rdfs:comment>
        <rdfs:label>isAnalysisOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmv/0.2#isDesignOf -->


    <owl:ObjectProperty rdf:about="http://w3id.org/mmv/0.2#isDesignOf">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#DesignActivity"/>
        <rdfs:range rdf:resource="http://w3id.org/mmv/0.2#MappingProject"/>
        <rdfs:comment>Inverse of hasDesign. Relates a DesignActivity to the MappingProject it belongs to.</rdfs:comment>
        <rdfs:label>isDesignOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmv/0.2#isDevelopmentOf -->


    <owl:ObjectProperty rdf:about="http://w3id.org/mmv/0.2#isDevelopmentOf">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#DevelopmentActivity"/>
        <rdfs:range rdf:resource="http://w3id.org/mmv/0.2#MappingProject"/>
        <rdfs:comment>Inverse of hasDevelopment. Relates a DevelopmentActivity to the MappingProject it belongs to.</rdfs:comment>
        <rdfs:label>isDevelopmentOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmv/0.2#isMaintenanceOf -->


    <owl:ObjectProperty rdf:about="http://w3id.org/mmv/0.2#isMaintenanceOf">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#MaintenanceActivity"/>
        <rdfs:range rdf:resource="http://w3id.org/mmv/0.2#MappingProject"/>
        <rdfs:comment>Inverse of hasMaintenance. Relates a MaintenanceActivity to the MappingProject it belongs to.</rdfs:comment>
        <rdfs:label>isMaintenanceOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmv/0.2#isMappingArtifactOf -->


    <owl:ObjectProperty rdf:about="http://w3id.org/mmv/0.2#isMappingArtifactOf">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#MappingArtifact"/>
        <rdfs:range rdf:resource="http://w3id.org/mmv/0.2#MappingProject"/>
        <rdfs:comment>Inverse of hasMappingArtifact. Relates a MappingArtifact to the MappingProject it belongs to.</rdfs:comment>
        <rdfs:label>isMappingArtifactOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmv/0.2#isTestingOf -->


    <owl:ObjectProperty rdf:about="http://w3id.org/mmv/0.2#isTestingOf">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#TestingActivity"/>
        <rdfs:range rdf:resource="http://w3id.org/mmv/0.2#MappingProject"/>
        <rdfs:comment>Inverse of hasTesting. Relates a TestingActivity to the MappingProject it belongs to.</rdfs:comment>
        <rdfs:label>isTestingOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmv/0.2#wasRevisionOfMapping -->


    <owl:ObjectProperty rdf:about="http://w3id.org/mmv/0.2#wasRevisionOfMapping">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#MappingArtifact"/>
        <rdfs:range rdf:resource="http://w3id.org/mmv/0.2#MappingArtifact"/>
        <rdfs:comment>revision link between mapping artifact versions</rdfs:comment>
        <rdfs:label>wasRevisionOfMapping</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasRevisionOf -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasRevisionOf">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#MappingArtifact"/>
    </owl:ObjectProperty>
    


    <!-- http://xmlns.com/foaf/0.1/homepage -->


    <owl:ObjectProperty rdf:about="http://xmlns.com/foaf/0.1/homepage">
        <rdfs:comment>Links an agent or resource to its homepage.</rdfs:comment>
        <rdfs:label>homepage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/mmv/0.2#hasAssumption -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasAssumption">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#AnalysisActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Records assumptions made during analysis about the source data, target model, or transformation logic, supporting correct interpretation and reuse.</rdfs:comment>
        <rdfs:label>hasAssumption</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasBackground -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasBackground">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Summarises relevant stakeholder expertise or experience, providing interpretive context for design and validation decisions.</rdfs:comment>
        <rdfs:label>hasBackground</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasDescription -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasDescription">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#MappingArtifact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Provides a concise description of a mapping artefact or project element to support understanding and discovery.</rdfs:comment>
        <rdfs:label>hasDescription</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasDesignDecision -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasDesignDecision">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#DesignActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Captures final design choices made during the design phase (e.g., modelling patterns, reuse choices), enabling rationale-aware reuse and comparison.</rdfs:comment>
        <rdfs:label>hasDesignDecision</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasDomainAssumption -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasDomainAssumption">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#AnalysisActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Captures assumptions about domain semantics or modelling expectations that affect mapping interpretation, helping others understand potential validity limits during reuse.</rdfs:comment>
        <rdfs:label>hasDomainAssumption</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasIdentifier -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasIdentifier">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#MappingArtifact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>Records a persistent identifier or IRI for a mapping artefact, supporting citation, discovery, and change tracking</rdfs:comment>
        <rdfs:label>hasIdentifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasInputCreator -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasInputCreator">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#AnalysisActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Identifies the creator of the input dataset as stated or known at the time of mapping creation, supporting provenance-aware reuse.</rdfs:comment>
        <rdfs:label>hasInputCreator</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasInputDescription -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasInputDescription">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#AnalysisActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Provides a concise description of the input dataset content and scope, to support understanding and reuse without requiring full dataset publication.</rdfs:comment>
        <rdfs:label>hasInputDescription</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasInputFormat -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasInputFormat">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#AnalysisActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Records the file format or media type of the input dataset (e.g., text/csv), supporting reproducibility and tool selection.</rdfs:comment>
        <rdfs:label>hasInputFormat</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasInputName -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasInputName">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#AnalysisActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Captures the human-readable name of an input dataset (e.g., a file name), supporting traceability of the source used during mapping creation.</rdfs:comment>
        <rdfs:label>hasInputName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasInputSource -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasInputSource">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#AnalysisActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Records the origin or provider of the input dataset (e.g., an archive, portal, or organisation), supporting traceability of the data used during mapping development.</rdfs:comment>
        <rdfs:label>hasInputSource</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasInputType -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasInputType">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#AnalysisActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Captures the type of input data (e.g., CSV, JSON, XML), supporting quick assessment of suitability and tool compatibility.</rdfs:comment>
        <rdfs:label>hasInputType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasJustification -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasJustification">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#DesignActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Provides the rationale for a recorded design decision, supporting transparency and helping future maintainers assess trade-offs.</rdfs:comment>
        <rdfs:label>hasJustification</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasMappingAlgorithm -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasMappingAlgorithm">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#DevelopmentActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Describes any algorithmic approach used to generate, validate, or automate the mapping (e.g., heuristic matching, rule-based transformation), supporting transparency.</rdfs:comment>
        <rdfs:label>hasMappingAlgorithm</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasMappingDomain -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasMappingDomain">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#AnalysisActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Indicates the subject area or domain the mapping addresses (e.g., cultural heritage, geospatial), supporting discovery and contextual reuse.</rdfs:comment>
        <rdfs:label>hasMappingDomain</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasPublisherName -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasPublisherName">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#MaintenanceActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Identifies the person or organisation responsible for publishing or releasing the mapping artefact, supporting provenance and citation.</rdfs:comment>
        <rdfs:label>hasPublisherName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasPublisherSource -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasPublisherSource">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#MaintenanceActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>Records where the published mapping artefact is hosted or referenced (e.g., repository URL), supporting traceability and reuse.</rdfs:comment>
        <rdfs:label>hasPublisherSource</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasPurpose -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasPurpose">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#AnalysisActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Describes the intended purpose or goal of the mapping project.</rdfs:comment>
        <rdfs:label>hasPurpose</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasRequirement -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasRequirement">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#AnalysisActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Records the requirements of the mapping project.</rdfs:comment>
        <rdfs:label>hasRequirement</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasRiskOrIssue -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasRiskOrIssue">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#AnalysisActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Records risks or issues related to the mapping project.</rdfs:comment>
        <rdfs:label>hasRiskOrIssue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasRole -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasRole">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Records the stakeholder role in the mapping project (e.g., developer, reviewer, domain expert), supporting accountability and provenance-oriented interpretation.</rdfs:comment>
        <rdfs:label>hasRole</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasTechnicalRequirement -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasTechnicalRequirement">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#AnalysisActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Records technical constraints that influence implementation choices (e.g., required tool support or execution environment), supporting reproducibility and future maintenance decisions.</rdfs:comment>
        <rdfs:label>hasTechnicalRequirement</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasTestingResult -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasTestingResult">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#TestingActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Records the outcome of a testing activity (e.g., pass/fail summary), supporting quality assessment and reuse decisions.</rdfs:comment>
        <rdfs:label>hasTestingResult</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasTestingType -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasTestingType">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#TestingActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Specifies the type of testing or validation performed (e.g., SHACL validation, unit testing), supporting assessment of mapping trustworthiness.</rdfs:comment>
        <rdfs:label>hasTestingType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasTool -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasTool">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#DevelopmentActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Lists the software tools or platforms used to create or edit the mapping (e.g., RMLEditor, Protégé), supporting reproducibility.</rdfs:comment>
        <rdfs:label>hasTool</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#hasVersionDateTime -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#hasVersionDateTime">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#MappingArtifact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Records the date and time when this version of the mapping artefact was created or released, supporting audit and reuse decisions.</rdfs:comment>
        <rdfs:label>hasVersionDateTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/mmv/0.2#version -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmv/0.2#version">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#MappingArtifact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Records a version identifier for the mapping artefact, enabling change tracking and controlled reuse across releases.</rdfs:comment>
        <rdfs:label>version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://alex-randles.github.io/MQV/#hasMappingFormat -->


    <owl:DatatypeProperty rdf:about="https://alex-randles.github.io/MQV/#hasMappingFormat">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#DevelopmentActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Reuse of the MQV property to specify the concrete syntax or encoding format in which a mapping definition is expressed, such as RML, R2RML, SPARQL, or SSSOM.</rdfs:comment>
        <rdfs:isDefinedBy>https://alex-randles.github.io/MQV/</rdfs:isDefinedBy>
        <rdfs:label>hasMappingFormat</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://alex-randles.github.io/MQV/#hasMappingMethod -->


    <owl:DatatypeProperty rdf:about="https://alex-randles.github.io/MQV/#hasMappingMethod">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#DevelopmentActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Reuse of the MQV property to describe the method by which a mapping was produced, such as manual, semi-automatic, or fully automatic generation.</rdfs:comment>
        <rdfs:isDefinedBy>https://alex-randles.github.io/MQV/</rdfs:isDefinedBy>
        <rdfs:label>hasMappingMethod</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://alex-randles.github.io/MQV/#hasMappingType -->


    <owl:DatatypeProperty rdf:about="https://alex-randles.github.io/MQV/#hasMappingType">
        <rdfs:domain rdf:resource="http://w3id.org/mmv/0.2#DevelopmentActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Reuse of the MQV property to indicate the type of mapping being created, for example uplift mapping, ontology alignment, or interlinking.</rdfs:comment>
        <rdfs:isDefinedBy>https://alex-randles.github.io/MQV/</rdfs:isDefinedBy>
        <rdfs:label>hasMappingType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/mmv/0.2#AnalysisActivity -->


    <owl:Class rdf:about="http://w3id.org/mmv/0.2#AnalysisActivity">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <owl:disjointWith rdf:resource="http://w3id.org/mmv/0.2#DesignActivity"/>
        <owl:disjointWith rdf:resource="http://w3id.org/mmv/0.2#DevelopmentActivity"/>
        <owl:disjointWith rdf:resource="http://w3id.org/mmv/0.2#MaintenanceActivity"/>
        <owl:disjointWith rdf:resource="http://w3id.org/mmv/0.2#TestingActivity"/>
        <vann:usageNote>@prefix mmv: &lt;http://w3id.org/mmv/0.2#&gt; .
@prefix ex: &lt;http://example.org/&gt; .

ex:analysis1 a mmv:AnalysisActivity ;
    mmv:hasPurpose &quot;To align historical datasets&quot; ;
    mmv:hasRequirement &quot;Map all person records to CIDOC-CRM&quot; ;
    mmv:hasRiskOrIssue &quot;Ambiguous geographic identifiers&quot; .</vann:usageNote>
        <rdfs:comment>Represents the analysis phase of a mapping project, where stakeholders, input datasets, requirements, assumptions, and potential risks are identified before mapping design and implementation.</rdfs:comment>
        <rdfs:label>AnalysisActivity</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmv/0.2#DataSet -->


    <owl:Class rdf:about="http://w3id.org/mmv/0.2#DataSet">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment>Represents a structured collection of data that serves as an input or output to a declarative mapping project, documented for analysis and reuse purposes rather than full dataset publication.</rdfs:comment>
        <rdfs:label>DataSet</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmv/0.2#DesignActivity -->


    <owl:Class rdf:about="http://w3id.org/mmv/0.2#DesignActivity">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <owl:disjointWith rdf:resource="http://w3id.org/mmv/0.2#DevelopmentActivity"/>
        <owl:disjointWith rdf:resource="http://w3id.org/mmv/0.2#MaintenanceActivity"/>
        <owl:disjointWith rdf:resource="http://w3id.org/mmv/0.2#TestingActivity"/>
        <rdfs:comment>Represents the design phase of a mapping project, where mapping decisions are made, including modeling choices, reuse considerations, and justifications for the selected approach.</rdfs:comment>
        <rdfs:label>DesignActivity</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmv/0.2#DevelopmentActivity -->


    <owl:Class rdf:about="http://w3id.org/mmv/0.2#DevelopmentActivity">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <owl:disjointWith rdf:resource="http://w3id.org/mmv/0.2#MaintenanceActivity"/>
        <owl:disjointWith rdf:resource="http://w3id.org/mmv/0.2#TestingActivity"/>
        <rdfs:comment>Represents the development phase of a mapping project, where mappings are implemented using specific tools, methods, algorithms, and formats.</rdfs:comment>
        <rdfs:label>DevelopmentActivity</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmv/0.2#MaintenanceActivity -->


    <owl:Class rdf:about="http://w3id.org/mmv/0.2#MaintenanceActivity">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <owl:disjointWith rdf:resource="http://w3id.org/mmv/0.2#TestingActivity"/>
        <vann:usageNote>@prefix mmv: &lt;http://w3id.org/mmv/0.2#&gt; .
@prefix ex: &lt;http://example.org/&gt; .

ex:maintenance1 a mmv:MaintenanceActivity ;
    mmv:hasPublisherName &quot;Trinity College Dublin&quot; .

ex:mappingV1 a mmv:MappingArtifact ;
    mmv:version &quot;1.0&quot; .
</vann:usageNote>
        <rdfs:comment>Represents the maintenance phase of a mapping project, where mapping artifacts are published, versioned, updated, and maintained over time.</rdfs:comment>
        <rdfs:label>MaintenanceActivity</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmv/0.2#MappingArtifact -->


    <owl:Class rdf:about="http://w3id.org/mmv/0.2#MappingArtifact">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/mmv/0.2#isMappingArtifactOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/mmv/0.2#MappingProject"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <vann:usageNote>@prefix mmv: &lt;http://w3id.org/mmv/0.2#&gt; .
@prefix prov: &lt;http://www.w3.org/ns/prov#&gt; .
@prefix ex: &lt;http://example.org/&gt; .

ex:mappingV2 a mmv:MappingArtifact ;
    prov:wasRevisionOf ex:mappingV1 ;
    mmv:version &quot;2.0&quot; .</vann:usageNote>
        <rdfs:comment>A tangible output of a mapping project, such as an RML file, ontology alignment, or linkset.</rdfs:comment>
        <rdfs:label>MappingArtifact</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmv/0.2#MappingProject -->


    <owl:Class rdf:about="http://w3id.org/mmv/0.2#MappingProject">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/mmv/0.2#hasMappingArtifact"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/mmv/0.2#MappingArtifact"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/mmv/0.2#hasAnalysis"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/mmv/0.2#AnalysisActivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/mmv/0.2#hasDesign"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/mmv/0.2#DesignActivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/mmv/0.2#hasDevelopment"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/mmv/0.2#DevelopmentActivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/mmv/0.2#hasMaintenance"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/mmv/0.2#MaintenanceActivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/mmv/0.2#hasTesting"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/mmv/0.2#TestingActivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <vann:usageNote>@prefix mmv: &lt;http://w3id.org/mmv/0.2#&gt; .
@prefix ex:  &lt;http://example.org/&gt; .

ex:project1 a mmv:MappingProject ;
    mmv:hasMappingArtifact ex:mappingV1 ;
    mmv:hasAnalysis ex:analysis1 .</vann:usageNote>
        <rdfs:comment>Represents a mapping project encompassing the analysis, design, development, testing, and maintenance of a single mapping artifact.</rdfs:comment>
        <rdfs:label>MappingProject</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmv/0.2#QualityAssessment -->


    <owl:Class rdf:about="http://w3id.org/mmv/0.2#QualityAssessment">
        <rdfs:subClassOf rdf:resource="http://w3id.org/mmv/0.2#TestingActivity"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment>Represents a quality assessment performed as part of the testing phase of a mapping project, focusing on the evaluation of mapping artifacts using quality metrics and assessment criteria.</rdfs:comment>
        <rdfs:label>QualityAssessment</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmv/0.2#TestingActivity -->


    <owl:Class rdf:about="http://w3id.org/mmv/0.2#TestingActivity">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <vann:usageNote>@prefix mmv: &lt;http://w3id.org/mmv/0.2#&gt; .
@prefix ex: &lt;http://example.org/&gt; .

ex:test1 a mmv:TestingActivity ;
    mmv:hasTestingType &quot;SHACL validation&quot; ;
    mmv:hasTestingResult &quot;All constraints satisfied&quot; .</vann:usageNote>
        <rdfs:comment>Represents the testing and validation phase of a mapping project, where mapping artifacts are tested, validated, and assessed to ensure correctness, consistency, and quality.</rdfs:comment>
        <rdfs:label>TestingActivity</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmv/0.2#ValidationReport -->


    <owl:Class rdf:about="http://w3id.org/mmv/0.2#ValidationReport">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment>A report documenting the outcomes of validating a mapping artefact against constraints (e.g., a SHACL validation report). Captures evidence of testing for transparency and reuse decisions.</rdfs:comment>
        <rdfs:label>ValidationReport</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#Resource -->


    <owl:Class rdf:about="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
    


